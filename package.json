{
  "name": "dsh-whale-musume",
  "version": "2.2.0",
  "private": true,
  "description": "A whale-girl Kanban Musume mascot for DeepSeek Harness",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts/setup-voice.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "setup:voice": "node scripts/setup-voice.mjs",
    "dev": "npx @deepseek-ai/dsh web --patch cordis.local.yml --port 3081",
    "test": "node --test test/*test.mjs",
    "qa": "node test/motion-qa.mjs && node test/cdp-whale-moe.mjs",
    "qa:soak": "node test/soak-work.mjs",
    "qa:voice": "node test/voice-live-smoke.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot",
    "desktop-pet",
    "whale-girl",
    "cute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-whale-musume.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-whale-musume/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-whale-musume#readme"
}
